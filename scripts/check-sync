#!/usr/bin/env bash
# Universal repository gate. Skill-specific repositories may run additional checks after this one.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

bash -n "$root/install.sh" "$root/scripts/check-sync"
[ ! -f "$root/scripts/init" ] || bash -n "$root/scripts/init"
[ ! -f "$root/scripts/test-init" ] || bash -n "$root/scripts/test-init"
python3 -m py_compile "$root/scripts/lint-skill" "$root/scripts/count-skill-tokens"

if [ -d "$root/skills/__SKILL_NAME__" ]; then
  repo="${GITHUB_REPOSITORY:-}"
  if [ "$(basename "$root")" != "skill-template" ] || { [ -n "$repo" ] && [ "$repo" != "gabros20/skill-template" ]; }; then
    echo "check-sync: FAIL: uninstantiated template in a derived repository; run scripts/init" >&2
    exit 1
  fi
  "$root/scripts/lint-skill"
  [ ! -x "$root/scripts/test-init" ] || "$root/scripts/test-init"
  echo "check-sync: OK — source template and initializer regression test passed"
  exit 0
fi

"$root/scripts/lint-skill"

while IFS= read -r -d '' script; do
  if head -1 "$script" | grep -qE '^#!/usr/bin/env bash|^#!/bin/bash'; then
    bash -n "$script"
  fi
done < <(find "$root/skills" -type f -path '*/scripts/*' -print0)

# 3d runtime tooling: compile every python script (extensionless shebang scripts included), then run the tests.
while IFS= read -r -d '' script; do
  if head -1 "$script" | grep -qE '^#!/usr/bin/env python3'; then
    python3 -m py_compile "$script"
  elif head -1 "$script" | grep -qE '^#!/usr/bin/env bash|^#!/bin/bash'; then
    bash -n "$script"
  fi
done < <(find "$root/skills/3d/scripts" "$root/skills/3d/assets/blender" -type f ! -name '*.pyc' -print0 2>/dev/null)
find "$root/skills/3d" -name '*.py' -not -path '*/node_modules/*' -print0 | xargs -0 -n1 python3 -m py_compile
find "$root/skills/3d" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
if [ -d "$root/tests" ]; then
  python3 -m unittest discover -s "$root/tests" >/dev/null 2>"$root/.check-sync-tests.log" \
    || { cat "$root/.check-sync-tests.log" >&2; rm -f "$root/.check-sync-tests.log"; echo "check-sync: FAIL: python tests" >&2; exit 1; }
  rm -f "$root/.check-sync-tests.log"
fi
if [ -d "$root/node_modules" ] && [ -f "$root/package.json" ]; then
  (cd "$root" && npm run --silent typecheck) || { echo "check-sync: FAIL: typecheck" >&2; exit 1; }
fi
[ -d "$root/node_modules" ] || echo "check-sync: note: typecheck skipped (run npm install to enable it)"

echo "check-sync: OK — package, routes, references, metadata, eval fixtures, and scripts validated"
