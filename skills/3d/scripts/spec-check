#!/usr/bin/env python3
"""spec-check FILE... — validate refspec.v1, shots.v1, look.v1, feasibility.v1 and rounds.v1 files.

The schema is detected from each file's `schema` field. Every problem is printed with its JSON path
(for example `$.shots[1].position: expected 3 finite numbers`). Also validates .3d/feasibility.json (feasibility.v1) and .3d/rounds.jsonl (rounds.v1, one object per line;
problems read `line N: $.path`). Rules mirror references/refspec.md
(leaf rule, anchors, unique ref ids), references/brief-spec.md (shots.json) and the look.v1 contract
(toneMapping, exposure > 0, environment room|.hdr|.exr, background #rrggbb|environment). Unknown extra keys
are allowed in refspec and shots; in look.json they print a WARN (exit stays 0).
Run by path with your project root as the working directory. Exit 0 all valid, 1 problems,
2 usage error (no file, unreadable path). Stdlib only.
"""
from __future__ import annotations

import argparse
import json
import math
import re
import sys
from pathlib import Path

CONFIDENCE = {"high", "med", "low"}
EVIDENCE = {"measured", "read", "inferred", "assumed", "unknown"}
MEDIUMS = {"photoreal", "cgi-real", "stylised-3d", "toon", "clay", "low-poly", "isometric",
           "flat-vector", "painterly", "mixed"}
EASES = {"linear", "in", "out", "inOut"}
TONEMAPS = {"neutral", "agx", "aces", "none"}
LENS_KEYS = ("focal_mm", "fov", "ortho_height")
ID_RE = re.compile(r"^[A-Za-z0-9_-]+$")
ASPECT_RE = re.compile(r"^\d+(\.\d+)?:\d+(\.\d+)?$")


def is_num(x: object) -> bool:
    return isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x)


def vec(x: object, n: int = 3) -> bool:
    return isinstance(x, list) and len(x) == n and all(is_num(v) for v in x)


class Report:
    def __init__(self) -> None:
        self.problems: list[str] = []
        self.warnings: list[str] = []

    def add(self, path: str, msg: str) -> None:
        self.problems.append(f"{path}: {msg}")

    def warn(self, path: str, msg: str) -> None:
        self.warnings.append(f"{path}: {msg}")


PROV_KINDS = {"photo", "offline-render", "realtime-capture", "ai-image", "ai-video", "unknown"}
CONSISTENCY = {"pass", "fail", "unknown"}
CATS = ("composition", "lighting", "materials", "colour", "motion", "fidelity")
FEATURE_CATS = set(CATS) | {"fx"}
TIERS = {"LIVE-NATIVE", "LIVE-WITH-TECHNIQUE", "BAKE-ONLY", "OFFLINE-ONLY", "REFERENCE-ARTEFACT"}
VISIBILITY = {"S", "O", "D", "S/O", "S-O", "O/D", "D/O", "-", "\u2014", "none"}
DYNAMICS = {"static", "dynamic", "mixed"}
TARGETS = {"mobile", "laptop", "desktop-webgpu"}
LABELS = {"FIXABLE", "CEILING", "ARTEFACT"}
# ids defined in references/realism-gap.md: features G1-G22, techniques T1-T18, artefacts R1-R5
G_RE = re.compile(r"^G(?:[1-9]|1\d|2[0-2])$")
T_RE = re.compile(r"^T(?:[1-9]|1[0-8])$")
R_RE = re.compile(r"^R[1-5]$")
V_RE = re.compile(r"^v\d+$")


def check_provenance(p: object, path: str, r: Report) -> None:
    if not isinstance(p, dict):
        r.add(path, "must be an object {kind, consistency{perspective, lighting, temporal}}")
        return
    if p.get("kind") not in PROV_KINDS:
        r.add(f"{path}.kind", f"must be one of {sorted(PROV_KINDS)}")
    if "evidence" in p and not (isinstance(p["evidence"], str) and p["evidence"].strip()):
        r.add(f"{path}.evidence", "must be a non-empty string (metadata, sibling prompt, user's words)")
    cons = p.get("consistency")
    if cons is not None:
        if not isinstance(cons, dict):
            r.add(f"{path}.consistency", "must be an object")
        else:
            for k in ("perspective", "lighting", "temporal"):
                if cons.get(k) not in CONSISTENCY:
                    r.add(f"{path}.consistency.{k}", f"must be one of {sorted(CONSISTENCY)}")


# --- refspec.v1 -------------------------------------------------------------------------------

def check_leaf(node: dict, path: str, r: Report) -> None:
    has_v, has_r = "value" in node, "range" in node
    if has_v == has_r:
        if not (node.get("evidence") == "unknown" and not has_v and not has_r):
            r.add(path, "leaf needs exactly one of `value` or `range` (only `unknown` leaves carry neither)")
    if node.get("confidence") not in CONFIDENCE:
        r.add(f"{path}.confidence", f"must be one of {sorted(CONFIDENCE)}")
    ev = node.get("evidence")
    if ev not in EVIDENCE:
        r.add(f"{path}.evidence", f"must be one of {sorted(EVIDENCE)}")
    if has_r:
        rg = node["range"]
        if not (isinstance(rg, list) and len(rg) == 2 and all(is_num(v) for v in rg) and rg[0] <= rg[1]):
            r.add(f"{path}.range", "expected [lo, hi] with lo <= hi")
    if ev in ("inferred", "assumed") and has_v and is_num(node["value"]):
        r.add(f"{path}.value", f"{ev} leaves must use `range` for numbers")
    if ev == "unknown" and (has_v or has_r):
        r.add(path, "unknown leaves carry no value")


def walk_leaves(node: object, path: str, r: Report) -> None:
    if isinstance(node, dict):
        if "confidence" in node or "evidence" in node:
            check_leaf(node, path, r)
        for k, v in node.items():
            walk_leaves(v, f"{path}.{k}", r)
    elif isinstance(node, list):
        for i, v in enumerate(node):
            walk_leaves(v, f"{path}[{i}]", r)


def check_refspec(doc: dict, r: Report) -> None:
    refs = doc.get("refs")
    if not isinstance(refs, list) or not refs:
        r.add("$.refs", "must be a non-empty array")
    else:
        seen: set[str] = set()
        for i, ref in enumerate(refs):
            p = f"$.refs[{i}]"
            if not isinstance(ref, dict):
                r.add(p, "must be an object")
                continue
            rid = ref.get("id")
            if not isinstance(rid, str) or not rid:
                r.add(f"{p}.id", "required string")
            elif rid in seen:
                r.add(f"{p}.id", f"duplicate id {rid!r}")
            else:
                seen.add(rid)
            if ref.get("kind") not in ("image", "video"):
                r.add(f"{p}.kind", "must be image or video")
            if not isinstance(ref.get("path"), str) or not ref.get("path"):
                r.add(f"{p}.path", "required string")
            if "weight" in ref and not (is_num(ref["weight"]) and 0 <= ref["weight"] <= 1):
                r.add(f"{p}.weight", "must be a number 0..1")
    anchors = doc.get("anchors")
    if not isinstance(anchors, list) or not 3 <= len(anchors) <= 5 or not all(isinstance(a, str) and a for a in anchors):
        r.add("$.anchors", "must be 3-5 non-empty strings")
    hidden = doc.get("hidden_or_unknown")
    if not isinstance(hidden, list) or not hidden:
        r.add("$.hidden_or_unknown", "must be a non-empty array")
    for key in ("type", "medium"):
        if key not in doc:
            r.add(f"$.{key}", "required")
    medium = doc.get("medium")
    if isinstance(medium, dict) and isinstance(medium.get("value"), str) and medium["value"] not in MEDIUMS:
        r.add("$.medium.value", f"must be one of {sorted(MEDIUMS)}")
    if "style_tokens" in doc and not (isinstance(doc["style_tokens"], list) and 1 <= len(doc["style_tokens"]) <= 3):
        r.add("$.style_tokens", "must be an array of 1-3 tokens")
    colour = doc.get("colour")
    if isinstance(colour, dict):
        for i, c in enumerate(colour.get("palette") or []):
            if not isinstance(c, dict) or not re.fullmatch(r"#[0-9a-fA-F]{6}", str(c.get("hex", ""))):
                r.add(f"$.colour.palette[{i}].hex", "must be #rrggbb")
        luma = colour.get("luma")
        if isinstance(luma, dict):
            for k in ("p5", "p50", "p95"):
                if k in luma and not (is_num(luma[k]) and 0 <= luma[k] <= 1):
                    r.add(f"$.colour.luma.{k}", "must be a number 0..1")
    if "provenance" in doc:
        check_provenance(doc["provenance"], "$.provenance", r)
    walk_leaves({k: v for k, v in doc.items() if k != "provenance"}, "$", r)  # provenance.evidence is free text


# --- shots.v1 ---------------------------------------------------------------------------------

def check_lens(obj: dict, path: str, r: Report, exactly_one: bool) -> None:
    present = [k for k in LENS_KEYS if k in obj]
    if exactly_one and len(present) != 1:
        r.add(path, f"needs exactly one of {'/'.join(LENS_KEYS)} (found {len(present)})")
    if not exactly_one and len(present) > 1:
        r.add(path, f"at most one of {'/'.join(LENS_KEYS)}")
    for k in present:
        v = obj[k]
        if not (is_num(v) and v > 0):
            r.add(f"{path}.{k}", "must be a positive number")
        elif k == "fov" and not v < 180:
            r.add(f"{path}.{k}", "vertical degrees must be < 180")


def check_pose(obj: dict, path: str, r: Report) -> None:
    for k in ("position", "target"):
        if k in obj and not vec(obj[k]):
            r.add(f"{path}.{k}", "expected 3 finite numbers [x, y, z]")
    if "roll_deg" in obj and not is_num(obj["roll_deg"]):
        r.add(f"{path}.roll_deg", "must be a number")


def check_shots(doc: dict, r: Report) -> None:
    if not isinstance(doc.get("aspect"), str) or not ASPECT_RE.match(doc["aspect"]):
        r.add("$.aspect", 'must be a "W:H" string such as "16:9"')
    if "fps" in doc and not (isinstance(doc["fps"], int) and not isinstance(doc["fps"], bool) and doc["fps"] > 0):
        r.add("$.fps", "must be a positive integer")
    shots = doc.get("shots")
    if not isinstance(shots, list) or not shots:
        r.add("$.shots", "must be a non-empty array")
        return
    seen: set[str] = set()
    ranges: list[tuple[float, float, str]] = []
    for i, s in enumerate(shots):
        p = f"$.shots[{i}]"
        if not isinstance(s, dict):
            r.add(p, "must be an object")
            continue
        sid = s.get("id")
        if not isinstance(sid, str) or not ID_RE.match(sid):
            r.add(f"{p}.id", "required, must match ^[A-Za-z0-9_-]+$")
        elif sid in seen:
            r.add(f"{p}.id", f"duplicate id {sid!r}")
        else:
            seen.add(sid)
        check_lens(s, p, r, True)
        for k in ("position", "target"):
            if k not in s:
                r.add(f"{p}.{k}", "required")
        check_pose(s, p, r)
        if "duration_s" in s and not (is_num(s["duration_s"]) and s["duration_s"] > 0):
            r.add(f"{p}.duration_s", "must be a positive number")
        if "t" in s and not (is_num(s["t"]) and s["t"] >= 0):
            r.add(f"{p}.t", "must be a number >= 0 (seconds)")
        if "ease" in s and s["ease"] not in EASES:
            r.add(f"{p}.ease", f"must be one of {sorted(EASES)}")
        sc = s.get("scroll")
        if sc is not None:
            if not (isinstance(sc, list) and len(sc) == 2 and all(is_num(v) and 0 <= v <= 1 for v in sc) and sc[0] < sc[1]):
                r.add(f"{p}.scroll", "expected [start, end] within 0..1 with start < end")
            else:
                ranges.append((sc[0], sc[1], p))
        to = s.get("to")
        if to is not None:
            if not isinstance(to, dict):
                r.add(f"{p}.to", "must be an object")
            else:
                for k in to:
                    if k not in ("position", "target", "focal_mm", "fov", "ortho_height", "roll_deg"):
                        r.add(f"{p}.to.{k}", "not allowed in an end pose")
                check_lens(to, f"{p}.to", r, False)
                check_pose(to, f"{p}.to", r)
    ranges.sort()
    for (a0, a1, ap), (b0, b1, bp) in zip(ranges, ranges[1:]):
        if b0 < a1 - 1e-9:
            r.add(f"{bp}.scroll", f"overlaps {ap}.scroll")


# --- look.v1 ----------------------------------------------------------------------------------

def score(x: object) -> bool:
    return is_num(x) and 0 <= x <= 3


def cat_map(doc: dict, key: str, path: str, r: Report, extra: tuple[str, ...] = ()) -> dict:
    m = doc.get(key)
    if not isinstance(m, dict):
        r.add(path, f"required object with one 0..3 number per category {list(CATS)}")
        return {}
    for c in (*CATS, *extra):
        if not score(m.get(c)):
            r.add(f"{path}.{c}", "required number 0..3")
    for k in m:
        if k not in (*CATS, *extra):
            r.warn(f"{path}.{k}", "unknown category")
    return m


def tech_ok(v: object) -> bool:
    items = v if isinstance(v, list) else [v]
    return bool(items) and all(isinstance(t, str) and (T_RE.match(t) or t.startswith("fit:") and len(t) > 4) for t in items)


def check_feasibility(doc: dict, r: Report) -> None:
    if not isinstance(doc.get("pipeline"), str) or not doc["pipeline"].strip():
        r.add("$.pipeline", "required non-empty string")
    if doc.get("dynamics") not in DYNAMICS:
        r.add("$.dynamics", f"must be one of {sorted(DYNAMICS)}")
    if doc.get("target") not in TARGETS:
        r.add("$.target", f"must be one of {sorted(TARGETS)}")
    if "provenance" in doc:
        check_provenance(doc["provenance"], "$.provenance", r)
    feats = doc.get("features")
    if not isinstance(feats, list):
        r.add("$.features", "must be an array of {g, category, visibility, tier, technique}")
    else:
        for i, f in enumerate(feats):
            p = f"$.features[{i}]"
            if not isinstance(f, dict):
                r.add(p, "must be an object")
                continue
            if not (isinstance(f.get("g"), str) and G_RE.match(f["g"])):
                r.add(f"{p}.g", "must be G1..G22")
            if f.get("category") not in FEATURE_CATS:
                r.add(f"{p}.category", f"must be one of {sorted(FEATURE_CATS)}")
            if "visibility" in f and f["visibility"] not in VISIBILITY:
                r.add(f"{p}.visibility", f"must be one of {sorted(VISIBILITY)}")
            if f.get("tier") not in TIERS:
                r.add(f"{p}.tier", f"must be one of {sorted(TIERS)}")
            if f.get("technique") not in (None, "", []) and not tech_ok(f["technique"]):
                r.add(f"{p}.technique", "must be T1..T18 (or a list)")
            elif f.get("tier") in ("LIVE-WITH-TECHNIQUE", "BAKE-ONLY") and f.get("technique") in (None, "", []):
                r.add(f"{p}.technique", f"{f['tier']} features name the technique that closes them")
    ceiling = cat_map(doc, "ceiling", "$.ceiling", r)
    cat_map(doc, "reference_target", "$.reference_target", r)
    bar = cat_map(doc, "ship_bar", "$.ship_bar", r, extra=("avg",))
    for c in CATS:
        if score(bar.get(c)) and score(ceiling.get(c)) and bar[c] > ceiling[c] + 1e-9:
            r.warn(f"$.ship_bar.{c}", f"bar {bar[c]} is above the ceiling {ceiling[c]} (the user raised it?)")
    b = doc.get("budget")
    if not isinstance(b, dict) or not (isinstance(b.get("rounds"), int) and not isinstance(b["rounds"], bool) and b["rounds"] >= 1):
        r.add("$.budget.rounds", "required integer >= 1")
    elif "tokens" in b and not (isinstance(b["tokens"], int) and not isinstance(b["tokens"], bool) and b["tokens"] > 0):
        r.add("$.budget.tokens", "must be a positive integer")
    if not isinstance(doc.get("accepted"), bool):
        r.add("$.accepted", "required boolean")


def check_rounds(doc: dict, r: Report) -> None:
    rd = doc.get("round")
    if not (isinstance(rd, int) and not isinstance(rd, bool) and rd >= 1):
        r.add("$.round", "required integer >= 1")
    if not (isinstance(doc.get("version"), str) and V_RE.match(doc["version"])):
        r.add("$.version", "must look like v003")
    scores = cat_map(doc, "scores", "$.scores", r)
    if not score(doc.get("avg")):
        r.add("$.avg", "required number 0..3")
    elif len(scores) and all(score(scores.get(c)) for c in CATS):
        mean = sum(scores[c] for c in CATS) / len(CATS)
        if abs(mean - doc["avg"]) > 0.06:
            r.warn("$.avg", f"{doc['avg']} differs from the mean of scores ({mean:.2f})")
    defects = doc.get("defects")
    if not isinstance(defects, list):
        r.add("$.defects", "required array (empty when none)")
        defects = []
    seen: set[str] = set()
    for i, d in enumerate(defects):
        p = f"$.defects[{i}]"
        if not isinstance(d, dict):
            r.add(p, "must be an object")
            continue
        did = d.get("id")
        if not isinstance(did, str) or not did.strip():
            r.add(f"{p}.id", "required non-empty string")
        elif did in seen:
            r.add(f"{p}.id", f"duplicate id {did!r}")
        else:
            seen.add(did)
        if d.get("category") not in FEATURE_CATS:
            r.add(f"{p}.category", f"must be one of {sorted(FEATURE_CATS)}")
        label = d.get("label")
        if label not in LABELS:
            r.add(f"{p}.label", f"must be one of {sorted(LABELS)}")
        elif label == "FIXABLE":
            if not tech_ok(d.get("technique")):
                r.add(f"{p}.technique", "FIXABLE needs T1..T18 or fit:<param>")
            if d.get("gain") not in (0.5, 1):
                r.add(f"{p}.gain", "FIXABLE needs gain 0.5 or 1")
        elif label == "CEILING":
            if not (isinstance(d.get("feature"), str) and G_RE.match(d["feature"])):
                r.add(f"{p}.feature", "CEILING needs the limiting feature id (G#)")
        elif label == "ARTEFACT":
            if not (isinstance(d.get("ref"), str) and R_RE.match(d["ref"])):
                r.add(f"{p}.ref", "ARTEFACT needs R1..R5")
            if not (isinstance(d.get("note"), str) and d["note"].strip()):
                r.add(f"{p}.note", "ARTEFACT needs the consistency evidence in note")
    if "twin" in doc and not isinstance(doc["twin"], str):
        r.add("$.twin", "must be a path string")


LOOK_KEYS = {"schema", "toneMapping", "exposure", "environment", "background"}


def check_look(doc: dict, r: Report) -> None:
    if doc.get("toneMapping") not in TONEMAPS:
        r.add("$.toneMapping", f"must be one of {sorted(TONEMAPS)}")
    if "exposure" in doc and not (is_num(doc["exposure"]) and doc["exposure"] > 0):
        r.add("$.exposure", "must be a number > 0 (three.js exposure multiplier)")
    if "environment" in doc:
        env = doc["environment"]
        ok = isinstance(env, str) and (env == "room" or env.split("?", 1)[0].split("#", 1)[0].lower().endswith((".hdr", ".exr")))
        if not ok:
            r.add("$.environment", 'must be "room" or a path/URL ending .hdr or .exr')
    if "background" in doc:
        bg = doc["background"]
        if not (isinstance(bg, str) and (bg == "environment" or re.fullmatch(r"#[0-9a-fA-F]{6}", bg))):
            r.add("$.background", 'must be "#rrggbb" or "environment"')
    for k in doc:
        if k not in LOOK_KEYS:
            r.warn(f"$.{k}", "unknown key (ignored by the viewer)")


CHECKS = {"refspec.v1": check_refspec, "shots.v1": check_shots, "look.v1": check_look,
          "feasibility.v1": check_feasibility, "rounds.v1": check_rounds}


def check_doc(doc: object) -> tuple[str, list[str], list[str]]:
    if not isinstance(doc, dict):
        return "unknown", ["$: root must be an object"], []
    schema = doc.get("schema")
    check = CHECKS.get(schema) if isinstance(schema, str) else None
    if check is None:
        return "unknown", [f"$.schema: must be one of {sorted(CHECKS)} (got {schema!r})"], []
    r = Report()
    check(doc, r)
    return schema, r.problems, r.warnings


def check_file(path: Path) -> tuple[str, list[str], list[str]]:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise SystemExit(f"spec-check: cannot read {path}: {exc}") from None
    if path.suffix.lower() == ".jsonl":
        schemas, problems, warnings = set(), [], []
        for n, line in enumerate(text.splitlines(), 1):
            if not line.strip():
                continue
            try:
                schema, p, w = check_doc(json.loads(line))
            except ValueError as exc:
                schema, p, w = "unknown", [f"$: invalid JSON ({exc})"], []
            schemas.add(schema)
            problems += [f"line {n}: {x}" for x in p]
            warnings += [f"line {n}: {x}" for x in w]
        if not schemas:
            problems.append("file has no lines")
        return ", ".join(sorted(schemas)) or "unknown", problems, warnings
    try:
        return check_doc(json.loads(text))
    except ValueError as exc:
        return "unknown", [f"$: invalid JSON ({exc})"], []


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Validate refspec.v1 / shots.v1 / look.v1 / feasibility.v1 / rounds.v1 files (.jsonl one line at a time) (schema auto-detected); prints bad JSON paths. "
                    "Run by path with your project root as the working directory. Exit 0 valid, 1 problems, 2 usage.")
    ap.add_argument("files", nargs="+", metavar="FILE")
    args = ap.parse_args()
    bad = False
    for name in args.files:
        p = Path(name)
        if not p.is_file():
            print(f"spec-check: not a file: {name}", file=sys.stderr)
            return 2
        try:
            schema, problems, warnings = check_file(p)
        except SystemExit as exc:
            print(exc, file=sys.stderr)
            return 2
        if problems:
            bad = True
            print(f"{name} ({schema}): {len(problems)} problem(s)")
            for line in problems:
                print(f"  {line}")
        else:
            print(f"{name} ({schema}): OK")
        for line in warnings:
            print(f"  WARN {line}")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
