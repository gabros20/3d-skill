#!/usr/bin/env python3
"""ref-extract INPUT... [--out .3d/refs] [--frames N] [--scene 0.3] — decompose reference media.

Per image or video, writes <out>/<name>/: meta.json (ffprobe), frames/ (video: scene-cut keyframes
plus evenly spaced fill; image: a copy), contact.jpg (tiled frames), palette.json (k-means k=6, hex +
weight), luma.json (16-bin histogram, mean, key, contrast, p5/p50/p95 on 0..1). Video also: cuts.json (cut timestamps in
seconds) and motion.json (8 samples/s; per sample: t seconds, energy 0..1 = mean abs frame diff,
dx/dy = global content shift in pixels of a 32x18 grey frame, positive = content moves right/down,
found by brute-force SAD over +-3 px, so camera pan/tilt is the opposite sign; speed_w_pct_s and
speed_h_pct_s = |dx|,|dy| as percent of frame width/height per second).
--regions N (2..8, video only) writes regions.json: {n, fps, t[], cells[]} where each cell is
{row, col, energy[] (mean abs frame diff 0..1 per sample, aligned with t[]), mean, peak, period_s};
period_s is the dominant repeat period of the cell's mean luma (autocorrelation peak > 0.3, 2 samples
to half the clip), null when the cell is static or not periodic. A blink on/off cycle reads as its full
period. --kymo (video only) writes kymo-rows.png (width = frame x, height = time; the horizontal line
at y) and kymo-cols.png (width = time, height = frame y; the vertical line at x), 8 samples/s, 480x270
sampling; --kymo-at X,Y sets the line position as 0..1 fractions (default 0.5,0.5) and implies --kymo.
--motion-json (video only) writes motion-summary.json: items[] for each region (id r<row>c<col>) of an N x N
grid (N from --regions, default 3) and for the kymo lines (ids kymo-row-<y>, kymo-col-<x>, at --kymo-at,
default 0.5,0.5), each with: period_s (fused: the mean-luma period, as regions.json, wins; agreement with
the shift-track period is in period_agree; period_luma_s / period_shift_s keep both), speed_w_pct_s /
speed_h_pct_s (median travel in %width / %height per second over samples that shift >= 1 sample px,
measured on the residual after removing the static background; peak_speed_* is the 90th percentile),
amplitude_x_px / amplitude_x_pct_w / amplitude_y_px / amplitude_y_pct_h (peak-to-peak sub-pixel sway by
normalised cross-correlation with the steady drift removed; px are source pixels; amplitude_pct_w,
amplitude_pct_h and amplitude_px are the same numbers under shorter names) and confidence high|med|low
with a `why`. kind_of_motion is travelling (one direction; only then are speed_* set), oscillating (reverses and
repeats; only then are amplitude_* set) or static; the other group is null and motion_note says why. Travel counts only shifts that keep one direction (>= 70% agree in sign); sway reverses, so
it reads as amplitude and period, not speed. Kymo items search 8 windows along the line (`windows` lists each
one with speed, sample count and direction share; sway_window and travel_window say which was used), so put
the line through the moving band with --kymo-at. Sampling is 320x180
grey at --motion-fps (default 24, capped at the source fps, at most 600 samples), so a reference and a
captured clip read the same.
Needs ffmpeg and ffprobe.
Run it by path with your project root as the working directory; --out (.3d/refs) and inputs resolve against it.
Exit 0 ok, 1 problems (missing ffmpeg, unreadable input), 2 usage. Stdlib + ffmpeg only.
"""
from __future__ import annotations

import argparse
import json
import math
import random
import re
import shutil
import struct
import subprocess
import sys
import zlib
from pathlib import Path

VIDEO_EXT = {".mp4", ".mov", ".m4v", ".webm", ".mkv", ".avi", ".gif", ".mpg", ".mpeg"}
SAMPLE_W = 64          # downscale width for palette/luma sampling
MOTION_FPS = 8         # motion samples per second
MOTION_MAX_S = 120     # cap analysed duration
KMEANS_K = 6
MAX_POINTS = 6000


class ExtractError(Exception):
    pass


def run(cmd: list[str], binary: bool = False, timeout: int = 300) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, capture_output=True, timeout=timeout, text=not binary)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise ExtractError(f"{cmd[0]} failed: {exc}")


def arg(path: Path) -> str:
    """Path as a command argument: a leading '-' would be parsed as an option."""
    s = str(path)
    return "./" + s if s.startswith("-") else s


def probe(path: Path) -> dict:
    res = run(["ffprobe", "-v", "error", "-print_format", "json", "-show_format", "-show_streams", arg(path)])
    if res.returncode != 0:
        raise ExtractError(f"ffprobe cannot read {path}: {res.stderr.strip()[:200]}")
    try:
        return json.loads(res.stdout)
    except ValueError:
        raise ExtractError(f"ffprobe returned invalid JSON for {path}")


def duration_of(meta: dict) -> float:
    try:
        return float(meta.get("format", {}).get("duration") or 0)
    except ValueError:
        return 0.0


def scene_cuts(path: Path, threshold: float) -> list[float]:
    res = run(["ffmpeg", "-hide_banner", "-nostats", "-i", arg(path), "-an",
               "-vf", f"select='gt(scene,{threshold})',showinfo", "-f", "null", "-"])
    cuts = [float(m) for m in re.findall(r"pts_time:([0-9.]+)", res.stderr)]
    return sorted(set(round(c, 3) for c in cuts))


def pick_times(duration: float, cuts: list[float], n: int) -> list[float]:
    """Scene cuts first (evenly thinned to n), then evenly spaced fill; always includes t≈0."""
    base = [0.0]
    room = max(n - 1, 0)
    if len(cuts) > room and room:
        step = len(cuts) / room
        cuts = [cuts[int(i * step)] for i in range(room)]
    times = base + cuts[:room]
    if len(times) < n and duration > 0:
        k = n - len(times)
        fill = [duration * (i + 0.5) / k for i in range(k)]
        for t in fill:
            if all(abs(t - e) > duration * 0.02 for e in times):
                times.append(t)
        # top up if the spacing filter dropped some
        j = 1
        while len(times) < n and j < 4 * n:
            t = duration * j / (4 * n)
            if all(abs(t - e) > duration * 0.01 for e in times):
                times.append(t)
            j += 1
    return sorted(round(min(t, max(duration - 0.05, 0)), 3) for t in times)[:n]


def grab_frame(src: Path, t: float, out: Path) -> bool:
    res = run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-ss", f"{t:.3f}", "-i", arg(src),
               "-frames:v", "1", "-q:v", "2", str(out)])
    return res.returncode == 0 and out.is_file() and out.stat().st_size > 0


def make_contact(frames: list[Path], out: Path) -> None:
    if not frames:
        return
    cols = min(4, len(frames))
    rows = math.ceil(len(frames) / cols)
    vf = f"scale=320:180:force_original_aspect_ratio=decrease,pad=320:180:(ow-iw)/2:(oh-ih)/2:color=black,tile={cols}x{rows}"
    if len(frames) > 1 and all(re.fullmatch(r"frame_\d{3}\.jpg", f.name) for f in frames):
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-framerate", "1",
               "-i", str(frames[0].parent / "frame_%03d.jpg"), "-vf", vf, "-frames:v", "1", "-q:v", "3", str(out)]
    else:
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-i", str(frames[0]),
               "-vf", vf, "-frames:v", "1", "-q:v", "3", str(out)]
    res = run(cmd)
    if res.returncode != 0:
        raise ExtractError(f"contact sheet failed: {res.stderr.strip()[:200]}")


def read_ppm(data: bytes) -> list[tuple[int, int, int]]:
    m = re.match(rb"P6\s+(\d+)\s+(\d+)\s+(\d+)\s", data)
    if not m:
        return []
    w, h = int(m.group(1)), int(m.group(2))
    body = data[m.end(): m.end() + w * h * 3]
    return [(body[i], body[i + 1], body[i + 2]) for i in range(0, len(body) - 2, 3)]


def sample_pixels(frame: Path) -> list[tuple[int, int, int]]:
    res = run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-i", str(frame),
               "-vf", f"scale={SAMPLE_W}:-2", "-frames:v", "1", "-f", "image2pipe", "-vcodec", "ppm", "-"], binary=True)
    if res.returncode != 0:
        raise ExtractError(f"cannot decode {frame.name}: {res.stderr.decode(errors='replace').strip()[:200]}")
    return read_ppm(res.stdout)


def kmeans(points: list[tuple[int, int, int]], k: int, iters: int = 12) -> list[dict]:
    rng = random.Random(0)
    if len(points) > MAX_POINTS:
        points = rng.sample(points, MAX_POINTS)
    if not points:
        return []
    # k-means++ seeding
    centers = [rng.choice(points)]
    while len(centers) < k:
        d2 = [min(sum((a - b) ** 2 for a, b in zip(p, c)) for c in centers) for p in points]
        total = sum(d2)
        if total == 0:
            break
        r, acc = rng.random() * total, 0.0
        for p, d in zip(points, d2):
            acc += d
            if acc >= r:
                centers.append(p)
                break
    centers = [tuple(float(x) for x in c) for c in centers]
    assign = [0] * len(points)
    for _ in range(iters):
        changed = False
        for i, p in enumerate(points):
            best = min(range(len(centers)), key=lambda j: sum((p[a] - centers[j][a]) ** 2 for a in range(3)))
            if best != assign[i]:
                assign[i], changed = best, True
        sums = [[0.0, 0.0, 0.0, 0] for _ in centers]
        for p, a in zip(points, assign):
            s = sums[a]
            s[0] += p[0]; s[1] += p[1]; s[2] += p[2]; s[3] += 1
        centers = [(s[0] / s[3], s[1] / s[3], s[2] / s[3]) if s[3] else centers[j] for j, s in enumerate(sums)]
        if not changed:
            break
    counts = [0] * len(centers)
    for a in assign:
        counts[a] += 1
    out = [{"hex": "#%02x%02x%02x" % tuple(int(round(c)) for c in cen), "weight": round(n / len(points), 4)}
           for cen, n in zip(centers, counts) if n]
    return sorted(out, key=lambda x: -x["weight"])


def luma_stats(points: list[tuple[int, int, int]]) -> dict:
    if not points:
        return {}
    ys = sorted(0.2126 * r + 0.7152 * g + 0.0722 * b for r, g, b in points)
    n = len(ys)
    hist = [0] * 16
    for y in ys:
        hist[min(int(y / 16), 15)] += 1
    mean = sum(ys) / n / 255
    p5, p95 = ys[int(n * 0.05)], ys[min(int(n * 0.95), n - 1)]
    key = "low" if mean < 0.35 else "mid" if mean < 0.65 else "high"
    return {"bins": 16, "histogram": [round(h / n, 4) for h in hist], "mean": round(mean, 4),
            "key": key, "contrast": round((p95 - p5) / 255, 4),
            "p5": round(p5 / 255, 4), "p50": round(ys[n // 2] / 255, 4), "p95": round(p95 / 255, 4)}


def global_shift(prev: bytes, cur: bytes, w: int, h: int, reach: int = 3) -> tuple[int, int]:
    """Offset (dx, dy) minimising mean abs diff when prev is shifted by it onto cur; (0, 0) wins ties."""
    best, best_xy = None, (0, 0)
    offsets = sorted(((dx, dy) for dx in range(-reach, reach + 1) for dy in range(-reach, reach + 1)),
                     key=lambda o: abs(o[0]) + abs(o[1]))
    for dx, dy in offsets:
        total, n = 0, 0
        for y in range(max(0, dy), min(h, h + dy)):
            row_c, row_p = y * w, (y - dy) * w
            x0, x1 = max(0, dx), min(w, w + dx)
            c = cur[row_c + x0: row_c + x1]
            p = prev[row_p + x0 - dx: row_p + x1 - dx]
            total += sum(abs(a - b) for a, b in zip(c, p))
            n += x1 - x0
        score = total / n if n else 1e9
        if best is None or score < best - 1e-9:
            best, best_xy = score, (dx, dy)
    return best_xy


def motion_energy(path: Path) -> list[dict]:
    w, h = 32, 18
    res = run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-t", str(MOTION_MAX_S), "-i", arg(path), "-an",
               "-vf", f"fps={MOTION_FPS},scale={w}:{h},format=gray", "-f", "rawvideo", "-"], binary=True)
    if res.returncode != 0:
        raise ExtractError(f"motion pass failed: {res.stderr.decode(errors='replace').strip()[:200]}")
    data, size, out, prev = res.stdout, w * h, [], None
    for i in range(len(data) // size):
        cur = data[i * size:(i + 1) * size]
        if prev is not None:
            e = sum(abs(a - b) for a, b in zip(cur, prev)) / size / 255
            dx, dy = global_shift(prev, cur, w, h) if e > 0.002 else (0, 0)
            out.append({"t": round(i / MOTION_FPS, 3), "energy": round(e, 5), "dx": dx, "dy": dy,
                        "speed_w_pct_s": round(abs(dx) / w * 100 * MOTION_FPS, 2),
                        "speed_h_pct_s": round(abs(dy) / h * 100 * MOTION_FPS, 2)})
        prev = cur
    return out


def cell_period(series: list[float], fps: float, min_var: float = 1.0) -> float | None:
    """Smallest lag whose normalised autocorrelation is a local peak above 0.3, in seconds."""
    n = len(series)
    if n < 6:
        return None
    mu = sum(series) / n
    x = [v - mu for v in series]
    var = sum(v * v for v in x)
    if var / n < min_var:  # flat signal (luma units^2 by default)
        return None
    top = n // 2
    r = [sum(x[i] * x[i + lag] for i in range(n - lag)) / var for lag in range(top + 2)]
    for lag in range(2, top + 1):
        if r[lag] > 0.3 and r[lag] >= r[lag - 1] and r[lag] >= r[lag + 1]:
            return round(lag / fps, 3)
    return None


def region_grid(path: Path, n: int) -> dict:
    side = n * max(4, math.ceil(48 / n))
    res = run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-t", str(MOTION_MAX_S), "-i", arg(path), "-an",
               "-vf", f"fps={MOTION_FPS},scale={side}:{side},format=gray", "-f", "rawvideo", "-"], binary=True)
    if res.returncode != 0:
        raise ExtractError(f"regions pass failed: {res.stderr.decode(errors='replace').strip()[:200]}")
    data, size, cs = res.stdout, side * side, side // n
    frames = len(data) // size
    luma = [[[] for _ in range(n)] for _ in range(n)]
    energy = [[[] for _ in range(n)] for _ in range(n)]
    for f in range(frames):
        cur = data[f * size:(f + 1) * size]
        prev = data[(f - 1) * size:f * size] if f else None
        for r in range(n):
            for c in range(n):
                tot = dif = 0
                for y in range(r * cs, (r + 1) * cs):
                    row = cur[y * side + c * cs: y * side + (c + 1) * cs]
                    tot += sum(row)
                    if prev is not None:
                        dif += sum(abs(a - b) for a, b in zip(row, prev[y * side + c * cs: y * side + (c + 1) * cs]))
                luma[r][c].append(tot / (cs * cs))
                if prev is not None:
                    energy[r][c].append(round(dif / (cs * cs) / 255, 5))
    cells = []
    for r in range(n):
        for c in range(n):
            e = energy[r][c]
            cells.append({"row": r, "col": c, "energy": e, "mean": round(sum(e) / len(e), 5) if e else 0.0,
                          "peak": max(e) if e else 0.0, "period_s": cell_period(luma[r][c], MOTION_FPS)})
    return {"n": n, "fps": MOTION_FPS, "t": [round(i / MOTION_FPS, 3) for i in range(1, frames)], "cells": cells}


SUM_W, SUM_H = 320, 180      # motion-summary sampling size (grey)
SUM_MAX_SAMPLES = 600        # cap on analysed samples (about 25 s at 24 fps)
RAW_REACH, TRAVEL_REACH = 4, 14   # px search for sway (raw) and travel (residual)
TRAVEL_DIR_FRAC = 0.7        # share of accepted shifts that must agree in sign to count as travel
MIN_PERIOD_S = 0.4           # shorter fused periods are treated as noise
TRAVEL_MIN_PX = 1.0          # a per-sample shift below this is sway/jitter, not travel
CONF_ORDER = ("low", "med", "high")


def ncc_lags(a: list[float], b: list[float], reach: int) -> tuple[float, float]:
    """Best sub-pixel lag s with b[i] ~ a[i - s] by normalised cross-correlation; returns (s, corr)."""
    n = len(a)
    curve: dict[int, float] = {}
    for s in range(-reach, reach + 1):
        lo, hi = max(0, s), min(n, n + s)
        if hi - lo < max(6, n // 3):
            continue
        x, y = b[lo:hi], a[lo - s:hi - s]
        mx, my = sum(x) / len(x), sum(y) / len(y)
        sx = math.sqrt(sum((v - mx) ** 2 for v in x))
        sy = math.sqrt(sum((v - my) ** 2 for v in y))
        curve[s] = sum((p - mx) * (q - my) for p, q in zip(x, y)) / (sx * sy) if sx > 1e-6 and sy > 1e-6 else 0.0
    if not curve:
        return 0.0, 0.0
    best = max(curve, key=lambda k: (curve[k], -abs(k)))
    sub = float(best)
    if best - 1 in curve and best + 1 in curve:
        l, c, r = curve[best - 1], curve[best], curve[best + 1]
        den = l - 2 * c + r
        if den < -1e-9:
            sub = best + max(-0.5, min(0.5, 0.5 * (l - r) / den))
    return sub, curve[best]


def pct(values: list[float], q: float) -> float:
    if not values:
        return 0.0
    v = sorted(values)
    return v[min(len(v) - 1, int(q * (len(v) - 1) + 0.5))]


def temporal_residual(profiles: list[list[float]]) -> list[list[float]]:
    """Profiles minus their per-position temporal median: leaves what moves, drops what holds still."""
    n = len(profiles[0])
    med = [sorted(p[i] for p in profiles)[len(profiles) // 2] for i in range(n)]
    return [[v - m for v, m in zip(p, med)] for p in profiles]


def window_analysis(profiles: list[list[float]], fps: float) -> dict:
    """Sway (raw sub-pixel track), travel (residual lags), and periods (shift track and mean luma) for one window."""
    pairs = len(profiles) - 1
    pos, acc, accepted = [], 0.0, 0
    for a, b in zip(profiles, profiles[1:]):
        s, c = ncc_lags(a, b, RAW_REACH)
        if c >= 0.8:
            acc += s
            accepted += 1
        pos.append(acc)
    if pairs > 1:
        slope = (pos[-1] - pos[0]) / (pairs - 1)
        det = [p - slope * i for i, p in enumerate(pos)]
        amp = max(det) - min(det)
    else:
        det, amp = pos, 0.0
    shift_period = cell_period(det, fps, 0.01) if amp >= 0.3 else None
    luma = [sum(p) / len(p) for p in profiles]
    k = len(luma)
    lslope = (luma[-1] - luma[0]) / (k - 1) if k > 1 else 0.0
    luma_period = cell_period([v - lslope * i for i, v in enumerate(luma)], fps, 1.0)
    if luma_period is not None and luma_period < MIN_PERIOD_S:
        luma_period = None  # sample-rate noise, not a repeat
    if shift_period is not None and shift_period < MIN_PERIOD_S:
        shift_period = None
    signed: list[float] = []
    res = temporal_residual(profiles)
    if max(max(abs(v) for v in p) for p in res) > 3:  # something moves in this window
        for a, b in zip(res, res[1:]):
            s, c = ncc_lags(a, b, TRAVEL_REACH)
            if c >= 0.6 and abs(s) >= TRAVEL_MIN_PX:
                signed.append(s)
    # travel keeps one direction; shifts that reverse sign are sway or flicker, not travel
    dir_frac = max(sum(1 for v in signed if v > 0), sum(1 for v in signed if v < 0)) / len(signed) if signed else 0.0
    if signed and dir_frac >= TRAVEL_DIR_FRAC:
        sign = 1 if sum(1 for v in signed if v > 0) >= len(signed) / 2 else -1
        travel = [abs(v) for v in signed if (v > 0) == (sign > 0)]
    else:
        travel = []
    return {"amp": amp, "coverage": accepted / pairs if pairs else 0.0, "shift_period": shift_period,
            "luma_period": luma_period, "travel": travel, "dir_frac": dir_frac, "signed_n": len(signed), "pairs": pairs, "fps": fps}


def fuse_period(shift_p: float | None, luma_p: float | None) -> tuple[float | None, bool | None, str]:
    """One period from two methods; the luma period wins ties so this never contradicts regions.json."""
    if shift_p and luma_p:
        agree = abs(shift_p - luma_p) <= 0.15 * max(shift_p, luma_p)
        return luma_p, agree, "high" if agree else "med"
    if luma_p:
        return luma_p, None, "med"
    if shift_p:
        return shift_p, None, "med"
    return None, None, "low"


def conf_max(a: str, b: str) -> str:
    return max(a, b, key=CONF_ORDER.index)


def axis_report(an: dict, size: int, src_px: int) -> dict:
    """Per-axis numbers from a window analysis; size = sample px on that axis."""
    unit = 100.0 / size
    t = an["travel"]
    n_t = len(t)
    tconf = "high" if n_t >= 20 else "med" if n_t >= 6 else "low"
    amp_pct = an["amp"] * unit
    return {"amp_pct": round(amp_pct, 3), "amp_px": round(an["amp"] * src_px / size, 2),
            "speed_pct_s": round(sorted(t)[len(t) // 2] * an["fps"] * unit, 3) if n_t >= 6 else 0.0,
            "peak_speed_pct_s": round(pct(t, 0.9) * an["fps"] * unit, 3) if n_t >= 6 else 0.0,
            "travel_samples": n_t, "travel_conf": tconf}


def item_fields(item_id: str, tx: dict | None, ty: dict | None, w: int, h: int, src_w: int, src_h: int) -> dict:
    ax = axis_report(tx, w, src_w) if tx else None
    ay = axis_report(ty, h, src_h) if ty else None
    main = max((a for a in (tx, ty) if a), key=lambda a: a["amp"] * (100.0 / (w if a is tx else h)))
    period, agree, pconf = fuse_period(main["shift_period"], main["luma_period"])
    if period is None:  # fall back to the other axis' periods
        other = ty if main is tx else tx
        if other:
            period, agree, pconf = fuse_period(other["shift_period"], other["luma_period"])
    tconf = max((a["travel_conf"] for a in (ax, ay) if a), key=CONF_ORDER.index, default="low")
    conf = conf_max(pconf, tconf)
    why = []
    if period:
        why.append(f"period {'agreed by shift and luma' if agree else 'from luma' if main['luma_period'] else 'from shift'}")
    if tconf != "low":
        why.append(f"travel from {max(a['travel_samples'] for a in (ax, ay) if a)} samples")
    if not why:
        why.append("little or no repeating or travelling motion found")
    out = {"id": item_id, "_signed_n": max(a["signed_n"] for a in (tx, ty) if a), "period_s": period, "period_luma_s": main["luma_period"],
           "period_shift_s": main["shift_period"], "period_agree": agree,
           "speed_w_pct_s": ax["speed_pct_s"] if ax else None, "speed_h_pct_s": ay["speed_pct_s"] if ay else None,
           "peak_speed_w_pct_s": ax["peak_speed_pct_s"] if ax else None,
           "peak_speed_h_pct_s": ay["peak_speed_pct_s"] if ay else None,
           "amplitude_x_px": ax["amp_px"] if ax else None, "amplitude_x_pct_w": ax["amp_pct"] if ax else None,
           "amplitude_y_px": ay["amp_px"] if ay else None, "amplitude_y_pct_h": ay["amp_pct"] if ay else None,
           "confidence": conf, "why": "; ".join(why)}
    return out


def classify_motion(out: dict) -> dict:
    """travelling (one direction) > oscillating (reverses, repeats) > static; speed only for travel, amplitude only for sway."""
    travelling = (out["speed_w_pct_s"] or 0) > 0 or (out["speed_h_pct_s"] or 0) > 0
    if travelling:
        kind, note = "travelling", "amplitude omitted: the shift track is dominated by travel, not sway"
    elif out["period_s"]:
        kind, note = "oscillating", "speed omitted: direction reverses"
    else:
        kind, note = "static", "no travel or repeating sway found"
    out["kind_of_motion"] = kind
    out["motion_note"] = note
    if kind != "travelling":
        for k in ("speed_w_pct_s", "speed_h_pct_s", "peak_speed_w_pct_s", "peak_speed_h_pct_s"):
            out[k] = None
    if kind != "oscillating":
        for k in ("amplitude_x_px", "amplitude_x_pct_w", "amplitude_y_px", "amplitude_y_pct_h"):
            out[k] = None
    out["amplitude_pct_w"], out["amplitude_pct_h"] = out["amplitude_x_pct_w"], out["amplitude_y_pct_h"]
    amps = [v for v in (out["amplitude_x_px"], out["amplitude_y_px"]) if v is not None]
    out["amplitude_px"] = max(amps) if amps else None
    return out


def line_windows(profile_rows: list[list[float]], fps: float, n_win: int = 8) -> list[tuple[float, float, dict]]:
    n = len(profile_rows[0])
    out = []
    for k in range(n_win):
        lo, hi = round(k * n / n_win), round((k + 1) * n / n_win)
        out.append((lo / n, hi / n, window_analysis([p[lo:hi] for p in profile_rows], fps)))
    return out


def line_item(item_id: str, kind_axis: str, at: tuple[float, float], profile_rows: list[list[float]], fps: float,
              size: int, other: int, src_px: int, horizontal: bool) -> dict:
    """Kymo line: sway from the whole line (or a strong window), travel from the best window along the line."""
    whole = window_analysis(profile_rows, fps)
    wins = line_windows(profile_rows, fps)
    best_n = max(len(t[2]["travel"]) for t in wins)
    # headline = the fastest window among those with >= 80% of the best sample count
    strong = [t for t in wins if best_n >= 6 and len(t[2]["travel"]) >= 0.8 * best_n]
    travel_win = max(strong, key=lambda t: sorted(t[2]["travel"])[len(t[2]["travel"]) // 2]) if strong else wins[0]
    sway_cands = [(0.0, 1.0, whole)] + [t for t in wins if t[2]["coverage"] >= 0.5]
    sway_win = max(sway_cands, key=lambda t: t[2]["amp"])
    merged = dict(sway_win[2])
    merged["travel"] = travel_win[2]["travel"] if len(travel_win[2]["travel"]) >= len(whole["travel"]) else whole["travel"]
    if not merged["shift_period"] and not merged["luma_period"]:
        merged["shift_period"], merged["luma_period"] = whole["shift_period"], whole["luma_period"]
    w, h = (size, other) if horizontal else (other, size)
    f = item_fields(item_id, merged if horizontal else None, None if horizontal else merged, w, h,
                    src_px if horizontal else 1, 1 if horizontal else src_px)
    classify_motion(f)
    f.update({"kind": "line", "axis": kind_axis, "at": [round(at[0], 3), round(at[1], 3)],
              "windows": [{"from": round(lo, 3), "to": round(hi, 3), "travel_samples": len(a["travel"]),
                           "speed_pct_s": round(sorted(a["travel"])[len(a["travel"]) // 2] * fps * 100.0 / size, 2)
                           if len(a["travel"]) >= 6 else 0.0, "direction_share": round(a["dir_frac"], 2),
                           "amplitude_pct": round(a["amp"] * 100.0 / size, 3)} for lo, hi, a in wins],
              "sway_window": [round(sway_win[0], 3), round(sway_win[1], 3)],
              "travel_window": [round(travel_win[0], 3), round(travel_win[1], 3)]})
    return f


def flag_mixed(items: list[dict]) -> None:
    """Oscillating items that look contaminated (outsized amplitude, or travel-like shifts that reverse) get low confidence."""
    def amp(i: dict) -> float:
        return max(v for v in (i["amplitude_x_pct_w"], i["amplitude_y_pct_h"]) if v is not None)
    osc = [i for i in items if i["kind_of_motion"] == "oscillating"]
    if not osc:
        return
    med = sorted(amp(i) for i in osc)[len(osc) // 2]
    for i in osc:
        if (med > 0 and amp(i) > 3 * med) or i.get("_signed_n", 0) >= 6:
            i["confidence"] = "low"
            i["motion_note"] = "mixed travel/oscillation \u2014 check visually"
    for i in items:
        i.pop("_signed_n", None)


def motion_summary(path: Path, n_regions: int, at: tuple[float, float], src_w: int, src_h: int,
                   src_fps: float, motion_fps: float, region_periods: dict | None = None) -> dict:
    w, h = SUM_W, SUM_H
    fps = min(src_fps, motion_fps) if src_fps > 0 else motion_fps
    dur = min(MOTION_MAX_S, SUM_MAX_SAMPLES / fps)
    res = run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-t", f"{dur:.3f}", "-i", arg(path), "-an",
               "-vf", f"fps={fps},scale={w}:{h},format=gray", "-f", "rawvideo", "-"], binary=True)
    if res.returncode != 0:
        raise ExtractError(f"motion-summary pass failed: {res.stderr.decode(errors='replace').strip()[:200]}")
    data, size = res.stdout, w * h
    frames = [data[i * size:(i + 1) * size] for i in range(len(data) // size)]
    if len(frames) < 8:
        raise ExtractError("clip too short for motion-summary (need at least 8 samples)")
    items = []
    xs = [round(i * w / n_regions) for i in range(n_regions + 1)]
    ys = [round(i * h / n_regions) for i in range(n_regions + 1)]
    for r in range(n_regions):
        for c in range(n_regions):
            x0, x1, y0, y1 = xs[c], xs[c + 1], ys[r], ys[r + 1]
            colp = [[sum(fr[y * w + x] for y in range(y0, y1)) / (y1 - y0) for x in range(x0, x1)] for fr in frames]
            rowp = [[sum(fr[y * w + x] for x in range(x0, x1)) / (x1 - x0) for y in range(y0, y1)] for fr in frames]
            it = item_fields(f"r{r}c{c}", window_analysis(colp, fps), window_analysis(rowp, fps), w, h, src_w, src_h)
            if region_periods is not None and (r, c) in region_periods:
                rp = region_periods[(r, c)]  # regions.json is the source of truth for a cell's period
                it["period_agree"] = None if rp is None or not it["period_shift_s"] else \
                    abs(rp - it["period_shift_s"]) <= 0.15 * max(rp, it["period_shift_s"])
                it["period_luma_s"] = rp
                if rp is None:
                    it["period_s"], it["confidence"] = None, "low" if not it["speed_w_pct_s"] and not it["speed_h_pct_s"] else it["confidence"]
                    it["why"] = "no luma repeat in regions.json" + ("; shift track suggests %ss (unconfirmed)" % it["period_shift_s"] if it["period_shift_s"] else "")
                else:
                    it["period_s"] = rp
                    if it["period_agree"] is False and it["confidence"] == "high":
                        it["confidence"] = "med"
            classify_motion(it)
            it.update({"kind": "region", "row": r, "col": c})
            items.append(it)
    fx, fy = at
    yl, xl = min(int(fy * h), h - 1), min(int(fx * w), w - 1)
    band = range(max(0, yl - 2), min(h, yl + 3))
    row_profiles = [[sum(fr[y * w + x] for y in band) / len(band) for x in range(w)] for fr in frames]
    cband = range(max(0, xl - 2), min(w, xl + 3))
    col_profiles = [[sum(fr[y * w + x] for x in cband) / len(cband) for y in range(h)] for fr in frames]
    items.append(line_item(f"kymo-row-{fy:g}", "row (horizontal line, x motion)", at, row_profiles, fps, w, h, src_w, True))
    items.append(line_item(f"kymo-col-{fx:g}", "col (vertical line, y motion)", at, col_profiles, fps, h, w, src_h, False))
    flag_mixed(items)
    return {"fps": fps, "sample": [w, h], "source": [src_w, src_h], "samples": len(frames), "regions": n_regions,
            "shift_positive": "content moves right/down",
            "speed": "median per-sample travel (shifts >= 1 sample px found on the residual after removing the static background)",
            "amplitude": "peak-to-peak of the sub-pixel shift track after removing steady drift (source px and % of frame)",
            "items": items}


def write_png(path: Path, w: int, h: int, rows: list[bytes]) -> None:
    def chunk(tag: bytes, body: bytes) -> bytes:
        return struct.pack(">I", len(body)) + tag + body + struct.pack(">I", zlib.crc32(tag + body))
    raw = b"".join(b"\x00" + r for r in rows)
    path.write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
                     + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def kymographs(path: Path, dest: Path, fx: float, fy: float) -> None:
    w, h = 480, 270
    x, y = min(int(fx * w), w - 1), min(int(fy * h), h - 1)
    try:
        proc = subprocess.Popen(["ffmpeg", "-hide_banner", "-loglevel", "error", "-t", str(MOTION_MAX_S), "-i", arg(path),
                                 "-an", "-vf", f"fps={MOTION_FPS},scale={w}:{h},format=rgb24", "-f", "rawvideo", "-"],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError as exc:
        raise ExtractError(f"kymograph pass failed: {exc}")
    size, rows, cols = w * h * 3, [], []
    assert proc.stdout is not None
    while True:
        buf = proc.stdout.read(size)
        if len(buf) < size:
            break
        rows.append(buf[y * w * 3:(y + 1) * w * 3])
        cols.append(b"".join(buf[(r * w + x) * 3:(r * w + x) * 3 + 3] for r in range(h)))
    proc.stdout.close()
    proc.wait()
    if not rows:
        raise ExtractError("kymograph pass produced no frames")
    write_png(dest / "kymo-rows.png", w, len(rows), rows)
    # kymo-cols: width = time, height = y; transpose the per-frame columns
    t = len(cols)
    write_png(dest / "kymo-cols.png", t, h,
              [b"".join(cols[i][r * 3:r * 3 + 3] for i in range(t)) for r in range(h)])


def unique_dir(out_root: Path, src: Path, used: set[str]) -> Path:
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", src.stem).strip("-") or "ref"
    base, n = name, 2
    while name in used:
        name, n = f"{base}-{n}", n + 1
    used.add(name)
    return out_root / name


def process(src: Path, dest: Path, frames_n: int, scene: float, regions: int = 0,
            kymo_at: tuple[float, float] | None = None, motion_json: bool = False,
            motion_fps: float = 24.0) -> dict:
    meta = probe(src)
    is_video = src.suffix.lower() in VIDEO_EXT and duration_of(meta) > 0
    dest.mkdir(parents=True, exist_ok=True)
    fdir = dest / "frames"
    shutil.rmtree(fdir, ignore_errors=True)  # no stale frames from an earlier run
    fdir.mkdir()
    (dest / "meta.json").write_text(json.dumps({"source": str(src), "kind": "video" if is_video else "image", **meta}, indent=2))
    frames: list[Path] = []
    cuts: list[float] = []
    if is_video:
        dur = duration_of(meta)
        cuts = scene_cuts(src, scene)
        for i, t in enumerate(pick_times(dur, cuts, frames_n), 1):
            f = fdir / f"frame_{i:03d}.jpg"
            if grab_frame(src, t, f):
                frames.append(f)
        if not frames:
            raise ExtractError(f"no frames could be extracted from {src}")
        (dest / "cuts.json").write_text(json.dumps({"threshold": scene, "duration": dur, "cuts": cuts}, indent=2))
        (dest / "motion.json").write_text(json.dumps({"fps": MOTION_FPS, "samples": motion_energy(src)}, indent=2))
        grid = region_grid(src, regions or 3) if (regions or motion_json) else None
        if regions and grid:
            (dest / "regions.json").write_text(json.dumps(grid))
        if kymo_at:
            kymographs(src, dest, *kymo_at)
        if motion_json:
            vs = next((st for st in meta.get("streams", []) if st.get("codec_type") == "video"), {})
            try:
                num, den = str(vs.get("r_frame_rate") or "0/1").split("/")
                src_fps = float(num) / float(den)
            except (ValueError, ZeroDivisionError):
                src_fps = 0.0
            (dest / "motion-summary.json").write_text(json.dumps(motion_summary(
                src, regions or 3, kymo_at or (0.5, 0.5), int(vs.get("width") or SUM_W), int(vs.get("height") or SUM_H),
                src_fps, motion_fps, {(c["row"], c["col"]): c["period_s"] for c in grid["cells"]} if grid else None),
                indent=2))
    else:
        if src.suffix.lower() in {".png", ".jpg", ".jpeg", ".webp"}:
            f = fdir / f"frame_001{src.suffix.lower()}"
            shutil.copyfile(src, f)
        else:  # avif / heic / tiff ...: viewer and preview list only png/jpg/webp
            f = fdir / "frame_001.jpg"
            if not grab_frame(src, 0.0, f):
                raise ExtractError(f"cannot decode image {src}")
        frames = [f]
    make_contact(frames, dest / "contact.jpg")
    pixels: list[tuple[int, int, int]] = []
    for f in frames:
        pixels.extend(sample_pixels(f))
    (dest / "palette.json").write_text(json.dumps({"k": KMEANS_K, "colors": kmeans(pixels, KMEANS_K)}, indent=2))
    (dest / "luma.json").write_text(json.dumps(luma_stats(pixels), indent=2))
    return {"input": str(src), "dir": str(dest), "kind": "video" if is_video else "image",
            "frames": len(frames), "cuts": len(cuts)}


def main() -> int:
    ap = argparse.ArgumentParser(description="Decompose reference images/videos: frames, contact sheet, palette, luma, cuts, motion. Run `<skill>/scripts/ref-extract` by path with your project root as the working directory; relative paths and defaults resolve against it.")
    ap.add_argument("inputs", nargs="+")
    ap.add_argument("--out", default=".3d/refs", help="output dir, relative to the current directory (your project root)")
    ap.add_argument("--frames", type=int, default=12, help="max keyframes per video (default 12)")
    ap.add_argument("--regions", type=int, default=0, metavar="N",
                    help="video: write regions.json, an NxN grid (2..8) of per-cell motion energy and dominant period")
    ap.add_argument("--motion-json", action="store_true",
                    help="video: write motion-summary.json (per region, default 3x3, and per kymo line: period, speed, "
                         "amplitude, confidence); identical for a reference video and a `preview capture --clip` mp4")
    ap.add_argument("--motion-fps", type=float, default=24.0, metavar="FPS",
                    help="sample rate for --motion-json, capped at the source fps (default 24; at most 600 samples are analysed)")
    ap.add_argument("--kymo", action="store_true", help="video: write kymo-rows.png and kymo-cols.png time-slice images")
    ap.add_argument("--kymo-at", default=None, metavar="X,Y",
                    help="kymograph line position as 0..1 fractions (default 0.5,0.5); implies --kymo")
    ap.add_argument("--scene", type=float, default=0.3, help="scene-cut threshold 0..1 (default 0.3)")
    args = ap.parse_args()
    if args.frames < 1 or not 0 < args.scene < 1:
        ap.error("--frames must be >= 1 and --scene in (0,1)")
    if args.regions and not 2 <= args.regions <= 8:
        ap.error("--regions must be 2..8")
    kymo_at = None
    if args.kymo or args.kymo_at:
        try:
            kymo_at = tuple(float(v) for v in (args.kymo_at or "0.5,0.5").split(","))  # type: ignore[assignment]
            assert len(kymo_at) == 2 and all(0 <= v <= 1 for v in kymo_at)
        except (ValueError, AssertionError):
            ap.error("--kymo-at must be X,Y fractions between 0 and 1, e.g. 0.5,0.5")
    if not shutil.which("ffmpeg") or not shutil.which("ffprobe"):
        print("ref-extract: ffmpeg and ffprobe are required and were not found on PATH.\n"
              "  install: brew install ffmpeg   (or your package manager); then re-run.", file=sys.stderr)
        return 1
    out_root, used, results, failed = Path(args.out), set(), [], False
    for raw in args.inputs:
        src = Path(raw)
        if not src.is_file():
            print(f"ref-extract: not a file: {raw}", file=sys.stderr)
            failed = True
            continue
        try:
            res = process(src, unique_dir(out_root, src, used), args.frames, args.scene, args.regions, kymo_at, args.motion_json, args.motion_fps)
        except ExtractError as exc:
            print(f"ref-extract: {raw}: {exc}", file=sys.stderr)
            failed = True
            continue
        results.append(res)
        print(f"ref-extract: {res['kind']} {raw} -> {res['dir']} ({res['frames']} frames, {res['cuts']} cuts)")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
